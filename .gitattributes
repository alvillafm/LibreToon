# Auto detect text files and perform LF normalization
* text=auto
# Keep the locked FFmpeg builder scripts byte-stable on Windows checkouts.
scripts/ffmpeg/*.sh text eol=lf
scripts/ffmpeg/*.json text eol=lf
scripts/*.ps1 text eol=lf

# Keep native build/source receipts and packaging recipes byte-stable.
scripts/ffmpeg/*.py text eol=lf
scripts/packaging/*.py text eol=lf
scripts/packaging/*.ps1 text eol=lf
scripts/packaging/*.iss text eol=lf
.github/workflows/*.yml text eol=lf
